# Values the operator supplies at deploy time. Nothing here is baked into the image.
PLATFORM_TOKEN=            # required: the platform tenant's bearer token
TENANT_TOKENS=             # optional: token:tenant_id pairs, comma separated
APPROVED_PRINCIPALS=       # optional: principals allowed to sign an approval
STORAGE_PATH=/app/data     # the one persistence root (declared in the Dockerfile)
DATABASE_URL=              # optional: postgresql+psycopg://user:pass@host/db
BACKUP_DIR=                # optional: defaults to $STORAGE_PATH/backups
FASTAPI_SYNC_THREADPOOL=8  # optional: sync request threadpool size
