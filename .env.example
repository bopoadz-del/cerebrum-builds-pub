# Settings the operator supplies before the platform is usable.
# The service fails closed (401 / 503 / unready health) without them.
PLATFORM_TOKEN=
# Country and currency for money labels; the uploaded BOQ names SAR, so set
# PLATFORM_CURRENCY=SAR unless the operator's own locale says otherwise.
PLATFORM_COUNTRY=
PLATFORM_CURRENCY=
PLATFORM_TAX_RATE=
# Additional tenants: comma-separated token:tenant_id pairs.
TENANT_TOKENS=
# Storage root for the one SQLite database and capability artifacts.
STORAGE_PATH=/app/data
# Principals allowed to sign high-impact approval fields.
APPROVED_PRINCIPALS=
# Project document management connector (document_register).
PROJECT_DOCUMENT_MANAGEMENT_SYSTEM_E_G_PROCORE_ACONEX_CREDENTIALS=
