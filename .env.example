# Required at deploy time. The platform refuses with 401 until a token is set.
PLATFORM_TOKEN=set-at-deploy
# Further tenants: comma-separated token:tenant pairs.
TENANT_TOKENS=
# Approvers the platform will accept on an approval field.
APPROVED_PRINCIPALS=
# One persistence root. The image declares it and the Store gate mounts there.
STORAGE_PATH=/data
# Where scheduled backups are written (defaults to STORAGE_PATH/backups).
BACKUP_DIR=
# Postgres when set; SQLite under STORAGE_PATH otherwise.
DATABASE_URL=
# Declared only when the operator has a country/currency they must enforce.
PLATFORM_COUNTRY=
PLATFORM_CURRENCY=
PLATFORM_TAX_RATE=
