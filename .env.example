# Settings the operator supplies at deploy time. Nothing here is loaded
# automatically and nothing here is baked into the runtime image: export the
# real values in the service environment before starting the container.

# Required. The platform tenant's bearer token. The app refuses every /v1
# request (401) until this is set; it has no default.
PLATFORM_TOKEN=

# Optional. Extra tenant tokens as comma-separated token:tenant_id pairs. The
# two values below are the local/acceptance bootstrap identities; production
# uses per-deploy random tokens with the same tenant ids.
TENANT_TOKENS=token-a:tenant-a,token-b:tenant-b

# Optional. Principals allowed to sign a high-impact approval field.
APPROVED_PRINCIPALS=director-jane

# The single persistence root. The image sets STORAGE_PATH=/app/data.
STORAGE_PATH=/app/data

# Optional. PostgreSQL DSN. Unset means the SQLite file under STORAGE_PATH.
DATABASE_URL=

# Required only by the email-delivery connector, which is a declared
# placeholder on this platform and answers 503 unavailable until configured.
EMAIL_DELIVERY_CREDENTIALS=

# The sync threadpool FastAPI runs request bodies on (concurrency drill).
FASTAPI_SYNC_THREADPOOL=8
