# Operator settings. Values are supplied at deploy time; nothing here is a
# working credential. Leave a value empty to keep the platform fail-closed.

# Bearer token for the platform tenant. REQUIRED: with no token every /v1
# route answers 401.
PLATFORM_TOKEN=

# Additional tenants: comma-separated token:tenant_id pairs.
TENANT_TOKENS=

# Principals allowed to sign an approval field (comma-separated).
APPROVED_PRINCIPALS=

# The one persistence root (the deploy image sets /app/data).
STORAGE_PATH=/app/data

# Optional Postgres. Absent means SQLite at $STORAGE_PATH/platform.db.
DATABASE_URL=

# HTTP port the service listens on.
PORT=8000

# Process revision and detectable mark used by the rollback drill.
APP_REVISION=rev-n
APP_MARK=baseline

# Optional backup directory (defaults to $STORAGE_PATH/backups).
BACKUP_DIR=
