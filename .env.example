# Copy to .env for local runs. Values are read at deploy time; none is baked in.
STORAGE_PATH=/data
PLATFORM_COUNTRY=
PLATFORM_CURRENCY=
PLATFORM_TOKEN=
PLATFORM_TAX_RATE=
# Optional: Postgres instead of the SQLite file under STORAGE_PATH
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/platform
