# Settings the operator MUST supply before the platform is useful.
# Every value below is read at run time; none is baked into the image.

# Authentication (no default: without PLATFORM_TOKEN every /v1 route is 401)
PLATFORM_TOKEN=
# Further tenants: comma-separated token:tenant pairs
TENANT_TOKENS=

# Persistence (one root; the image default is /data)
STORAGE_PATH=/data
BACKUP_DIR=/data/backups

# Money: country and currency are not declared by the brief, so they are
# operator settings; until PLATFORM_CURRENCY is set, money answers WITHHELD.
PLATFORM_COUNTRY=
PLATFORM_CURRENCY=
PLATFORM_TAX_RATE=

# Contract figures from the uploaded excerpt. Defaults are the clauses;
# set them if the contract is amended.
PLATFORM_RATE_RETENTION_PCT=5
PLATFORM_RATE_DELAY_DAMAGES_PCT_PER_DAY=0.1
PLATFORM_RATE_DELAY_DAMAGES_CAP_PCT=10
PLATFORM_RATE_TIME_FOR_COMPLETION_DAYS=730
PLATFORM_RATE_DNP_DAYS=365
PLATFORM_RATE_PERFORMANCE_SECURITY_PCT=10
PLATFORM_RATE_SECURITY_ALERT_DAYS=30

# Declared placeholder connectors: the five capabilities below answer HTTP
# 503 error_kind=unavailable until these are supplied.
PROJECT_ACCOUNTING_LEDGER_CREDENTIALS=
PRIMAVERA_P6_SCHEDULE_CREDENTIALS=
PROJECT_EDMS_CREDENTIALS=
BANK_GUARANTEE_AND_SURETY_PROVIDER_CREDENTIALS=
DEFECTS_AND_MAINTENANCE_SYSTEM_CREDENTIALS=

# Approvers the platform recognises (comma-separated principal ids)
APPROVED_PRINCIPALS=

# Optional Postgres. Absent means SQLite under STORAGE_PATH.
DATABASE_URL=
