# Copy to .env for local runs. Values are read at deploy time; none is baked in.
STORAGE_PATH=/data
PLATFORM_TOKEN=
TENANT_TOKENS=
PLATFORM_COUNTRY=
PLATFORM_CURRENCY=
PLATFORM_TAX_RATE=
SAP_ERP_CREDENTIALS=
OUTLOOK_CREDENTIALS=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REFRESH_TOKEN=
MICROSOFT365_CLIENT_ID=
MICROSOFT365_CLIENT_SECRET=
BACKUP_DIR=
UPLOAD_ROOT=
SENTRY_DSN=
# Optional: Postgres instead of the SQLite file under STORAGE_PATH
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/platform
