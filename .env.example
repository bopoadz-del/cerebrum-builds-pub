# Settings the operator supplies at deploy. Copy to .env for local work.
# No secret has a default anywhere in app/: an absent token fails closed.
#
# Required:
#   PLATFORM_TOKEN   the platform tenant's bearer token (no default)
#   PLATFORM_TAX_RATE  the customer's Tunisian VAT rate, as a decimal fraction
#
# Everything else is optional; the values below are documented examples.

# --- service ---------------------------------------------------------------
PORT=8000
STORAGE_PATH=/data
# Postgres instead of the SQLite file under STORAGE_PATH (app/db.py decides):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/product

# --- tenancy ---------------------------------------------------------------
# The platform token owns tenant "local" for this single-factory deployment.
PLATFORM_TOKEN=set-at-deploy
# Further tenants as `token:tenant_id` pairs, comma separated.
# TENANT_TOKENS=another-token:tenant-b
# Readable tenant names as `tenant_id:Display name` pairs.
# TENANT_NAMES=local:Coffee-compost factory
# Principals allowed to approve a staff revocation (comma separated).
APPROVED_PRINCIPALS=director-jane

# --- money (country and currency come from docs/declared_locale.json: TN/TND)
# Standard Tunisian VAT is 19%; the customer owns the rate and may change it.
PLATFORM_TAX_RATE=0.19
# PLATFORM_COUNTRY=TN
# PLATFORM_CURRENCY=TND

# --- the factory's own process settings (all optional; shown with defaults) --
# Compost yield ratio: finished compost kg per kg of coffee-waste input.
PLATFORM_RATE_COMPOST_YIELD=0.35
# A collection shortfall above this percentage raises an alert.
PICKUP_SHORTFALL_ALERT_PCT=15
# Compost quality bands checked on the production floor.
COMPOST_CURING_TARGET_DAYS=45
COMPOST_MOISTURE_MIN_PCT=35
COMPOST_MOISTURE_MAX_PCT=65
COMPOST_TEMPERATURE_MAX_C=70
COMPOST_PH_MIN=6.0
COMPOST_PH_MAX=8.5
COMPOST_CN_MIN=20
COMPOST_CN_MAX=35
# Catalog guard rails.
CATALOG_MIN_UNIT_PRICE=0
CATALOG_MAX_DISCOUNT_PCT=30
# Dashboard presentation.
DASHBOARD_REFRESH_SECONDS=30
DASHBOARD_UNPAID_ALERT=1
PLATFORM_DASHBOARD_THEME=light

# --- operations ------------------------------------------------------------
# BACKUP_DIR defaults to <STORAGE_PATH>/backups.
# BACKUP_DIR=/data/backups
# Authentication throttle (failed attempts per client per window).
AUTH_FAILURE_MAX=60
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW_S=60
# Optional Sentry error reporting; unset means no outbound reporting.
# SENTRY_DSN=
