# Harbourline Civil Works Contracts Administration Platform
# Operator settings.
#
# Copy to .env (or export the lines you need into the deploy environment) and
# fill in the values this deployment owns. Every entry below is COMMENTED OUT on
# purpose: nothing secret has a default, and a missing setting fails closed at
# the request that needs it rather than shipping a well-known value
# (app/config.py, app/tenancy.py, app/security.py, app/contract.py,
# app/money_settings.py read these once, by name).
#
# The image already declares STORAGE_PATH=/data and PORT=8000 (see Dockerfile);
# repeat them here only when you run outside the image or mount elsewhere.

# ---------------------------------------------------------------------------
# Authentication -- REQUIRED
# ---------------------------------------------------------------------------

# The platform principal's bearer token. Required: with PLATFORM_TOKEN unset
# every request is refused with 401 instead of admitting a guessed token.
# Clients send it as:  Authorization: Bearer <PLATFORM_TOKEN>
# PLATFORM_TOKEN=

# Further tenants, as comma-separated token:tenant pairs. Each token resolves to
# the tenant named after the colon; a caller only ever sees its own tenant's
# records. Optional -- leave unset for a single-tenant (platform) deployment.
# TENANT_TOKENS=<token>:<tenant_id>,<token>:<tenant_id>

# Principals allowed to approve a certification decision, a retention release or
# an ITP sign-off, comma separated. A free-text approver is refused (403); with
# no principals configured every approval path answers 503. Required for any
# capability that approves.
# APPROVED_PRINCIPALS=<approver-name>,<approver-name>

# ---------------------------------------------------------------------------
# Locale and tax -- the values the customer's contract declares
# ---------------------------------------------------------------------------

# ISO 4217 code the money paths report. Nothing is declared in the tree
# (docs/declared_locale.json carries no currency), so this is an operator
# setting: set it to what the uploaded contract excerpt states.
# PLATFORM_CURRENCY=SAR

# ISO 3166 country of the contract. Optional unless a money path asks for it.
# PLATFORM_COUNTRY=SA

# Tax rate as a fraction (0.15 for 15%). Optional: a money path that needs it
# refuses with "no tax rate set (PLATFORM_TAX_RATE)".
# PLATFORM_TAX_RATE=0.15

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

# Root the platform owns: the SQLite database (platform.db), work/ scratch files
# and the backups all live under it. Must be a writable directory -- /health
# reports 503 otherwise. Mount a volume here in a container.
# STORAGE_PATH=/data

# Where app/backup.py writes and reads SQLite backups. Defaults to
# $STORAGE_PATH/backups when unset.
# BACKUP_DIR=/data/backups

# Optional Postgres. When set, the platform runs on Postgres and STORAGE_PATH is
# used only for work/ and backups; when unset it runs on the SQLite file under
# STORAGE_PATH. postgres:// and postgresql:// are both accepted.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# ---------------------------------------------------------------------------
# Contract terms -- PLATFORM_TERM_<NAME> overrides
# ---------------------------------------------------------------------------
# Every rate and period below is a term of the uploaded contract excerpt
# (docs/contract_terms.json). With no override the declared value is used; an
# override replaces it for this deployment. Nothing here is a constant in code
# (app/contract.py: term()). Values are fractions, not percentages.

# Clause 14.3 -- retention held on each Interim Payment Certificate (declared 0.05).
# PLATFORM_TERM_RETENTION_RATE=0.05

# Clause 14.3 -- share of the retention released at Taking-Over (declared 0.5);
# the remainder is released at the end of the Defects Notification Period.
# PLATFORM_TERM_RETENTION_RELEASE_FIRST_SHARE=0.5

# Clause 4.2 -- performance security as a fraction of the Accepted Contract
# Amount (declared 0.1).
# PLATFORM_TERM_PERFORMANCE_SECURITY_RATE=0.1

# Clause 8.7 -- delay damages per day of delay (declared 0.001, i.e. 0.1%/day).
# PLATFORM_TERM_DELAY_DAMAGES_DAILY_RATE=0.001

# Clause 8.7 -- cap on delay damages (declared 0.1, i.e. 10% of the Accepted
# Contract Amount).
# PLATFORM_TERM_DELAY_DAMAGES_CAP_RATE=0.1

# Clause 8.2 -- Time for Completion in whole days (declared 730).
# PLATFORM_TERM_TIME_FOR_COMPLETION_DAYS=730

# Clause 11.1 -- Defects Notification Period in whole days (declared 365).
# PLATFORM_TERM_DEFECTS_NOTIFICATION_DAYS=365

# ---------------------------------------------------------------------------
# Process settings -- optional
# ---------------------------------------------------------------------------

# Port uvicorn binds (the image declares 8000).
# PORT=8000

# Tenant id the platform token resolves to. Defaults to "platform".
# PLATFORM_TENANT=platform

# Root that contains vendor/ when it is not the code root (app/dispatch.py).
# Leave unset in the image: the tree is copied under the WORKDIR.
# PRODUCT_ROOT=/app
