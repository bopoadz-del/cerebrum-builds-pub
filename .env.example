# Harbourline Civil Works Contracts Administration — deploy settings.
# Copy to .env for local runs; the platform reads the process environment.
# A setting with no default must be supplied or the path that needs it refuses.

# Persistence root. The Docker image declares /data and a volume mounts there.
STORAGE_PATH=/data

# Optional: PostgreSQL DSN. Absent means SQLite at $STORAGE_PATH/platform.db.
# DATABASE_URL=

# Port the server listens on (scripts/entrypoint.sh).
PORT=8000

# Authentication. No token is baked into the image; every /v1 route is 401
# without one. PLATFORM_TOKEN acts as the platform tenant; TENANT_TOKENS adds
# further tenants as comma-separated token:tenant pairs.
PLATFORM_TOKEN=set-at-deploy
TENANT_TOKENS=set-at-deploy

# Principals allowed to approve. An unknown approver is refused.
APPROVED_PRINCIPALS=set-at-deploy

# Money. Country and currency come from docs/declared_locale.json unless set
# here; the tax rate is always the operator's to set.
PLATFORM_COUNTRY=Saudi Arabia
PLATFORM_CURRENCY=SAR
PLATFORM_TAX_RATE=set-at-deploy

# Backups (scripts/backup.sh, app/backup.py). Defaults to $STORAGE_PATH/backups.
# BACKUP_DIR=/data/backups

# Observability: Sentry is used only when a DSN is supplied.
# SENTRY_DSN=

# Release identity, reported by /health and the entrypoint banner.
# APP_REVISION=
# APP_MARK=
