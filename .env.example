# Copy this to .env and set every value before the platform is used.
# The service refuses to start without STORAGE_PATH and PLATFORM_TOKEN; the
# rest have defaults that are stated here rather than hidden in code.

# --- required ---------------------------------------------------------------
STORAGE_PATH=/data
PLATFORM_TOKEN=set-a-long-random-value

# --- further tenants (token:tenant pairs, comma separated) -------------------
# TENANT_TOKENS=
# TENANT_ROLES=tenant-b:Registrar|Faculty

# --- database ---------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/cerebrum
# (absent means SQLite at $STORAGE_PATH/platform.db)

# --- programme settings the operator owns -----------------------------------
# PLATFORM_SESSION_START=09:00
# PLATFORM_CRITERION_WORDS=60
# PLATFORM_GRADUATION_AVERAGE=80

# --- declared placeholder connector -----------------------------------------
# Email delivery is NOT built in this package. Until it is, the two
# capabilities that send programme mail answer HTTP 503 error_kind
# "unavailable" naming this setting. Setting it does not enable delivery.
EMAIL_DELIVERY_CREDENTIALS=
