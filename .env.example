# Harbourline Civil Works contracts administration -- operator settings.
# Copy to .env (or set in the deploy environment) before first boot.
# Nothing here is baked into the image: every value is read at run time.

# --- Authentication (no default; without a token every /v1 route answers 401)
PLATFORM_TOKEN=
# Comma-separated token:tenant pairs for additional tenants.
TENANT_TOKENS=
# Principals allowed to approve (comma-separated). A free-text approver is refused.
APPROVED_PRINCIPALS=

# --- Persistence
STORAGE_PATH=/app/data
# Optional: a Postgres URL. Absent means SQLite under STORAGE_PATH.
DATABASE_URL=
BACKUP_DIR=/app/data/backups
SQLITE_BUSY_TIMEOUT_MS=5000
FASTAPI_SYNC_THREADPOOL=40

# --- Money settings (the brief names the currency; no tax rate is given)
PLATFORM_CURRENCY=SAR
# Country is not stated in the uploaded contract: the operator declares it.
PLATFORM_COUNTRY=
# No tax rate is named in the brief. Leave blank until the operator sets one;
# money paths that need it refuse while it is unset.
PLATFORM_TAX_RATE=

# --- Contract rates (Clauses 8.7, 14.3, 4.2; percentages)
PLATFORM_RATE_RETENTION_PCT=5
PLATFORM_RATE_DELAY_DAMAGES_PCT_PER_DAY=0.1
PLATFORM_RATE_DELAY_DAMAGES_CAP_PCT=10
PLATFORM_RATE_PERFORMANCE_SECURITY_PCT=10
# Contract periods in days (Clauses 8.2 and 11.1) and the security expiry alert window
PLATFORM_RATE_TIME_FOR_COMPLETION_DAYS=730
PLATFORM_RATE_DNP_DAYS=365
PLATFORM_RATE_SECURITY_ALERT_DAYS=30

# --- Declared placeholder connectors (the POST answers 503 until these exist)
PROJECT_ACCOUNTING_LEDGER_CREDENTIALS=
PRIMAVERA_P6_SCHEDULE_CREDENTIALS=
PROJECT_EDMS_CREDENTIALS=
BANK_GUARANTEE_AND_SURETY_PROVIDER_CREDENTIALS=
DEFECTS_AND_MAINTENANCE_SYSTEM_CREDENTIALS=

# --- Deployment identity / observability
APP_REVISION=
APP_MARK=
SENTRY_DSN=
