{
  "schema_version": "deploy.contract.v1",
  "product": {
    "id": "product",
    "name": "Harbourline Civil Works contracts administration",
    "revision_mark": {
      "baseline": "rev-n",
      "changed": "rev-n-plus-1"
    }
  },
  "image": {
    "dockerfile": "Dockerfile",
    "workdir": "/app",
    "command": "sh scripts/entrypoint.sh",
    "entrypoint": "scripts/entrypoint.sh",
    "runtime_requirements": "requirements.txt",
    "constraints": "constraints.txt",
    "build_context_includes": [
      "app/",
      "alembic/",
      "alembic.ini",
      "docs/",
      "kits/",
      "scripts/",
      "vendor/",
      "blocks.lock.json"
    ],
    "non_root_user": "appuser",
    "port": 8000
  },
  "health": {
    "path": "/health",
    "checks": ["process", "persistent_disk", "database", "migrations"],
    "fail_closed": true,
    "ok_status": 200,
    "unready_status": 503,
    "unconditional_ok_is": "F1"
  },
  "storage": {
    "env": "STORAGE_PATH",
    "mount": "/app/data",
    "database": "platform.db",
    "backup_dir": "$STORAGE_PATH/backups",
    "backup_retention": 14,
    "volume_gb": 1,
    "sqlite_on_mounted_disk": true,
    "journal_mode": "WAL",
    "synchronous": "NORMAL",
    "writers": 1,
    "busy_timeout_ms": 15000
  },
  "database": {
    "default_backend": "sqlite",
    "env": "DATABASE_URL",
    "postgres_driver": "psycopg",
    "schema_owner": "alembic",
    "migrations": "alembic/versions"
  },
  "capabilities": [
    {
      "id": "contract_source_of_record",
      "entity": "contract_source_of_record",
      "blocks": ["document_engine", "ocr", "pdf", "storage", "knowledge", "ingestion_provenance"]
    },
    {
      "id": "progress_claims",
      "entity": "progress_claims",
      "blocks": ["finance_reconciliation", "finance_canonical_model", "boq_processor", "validation", "approval_rules", "transaction_state_machine", "audit"]
    },
    {
      "id": "time_and_delay_damages",
      "entity": "time_and_delay_damages",
      "blocks": ["cpm_engine", "formula_executor", "finance_planning", "notification", "dashboard", "audit"]
    },
    {
      "id": "qa_itp_records",
      "entity": "qa_itp_records",
      "blocks": ["workbench", "workflow", "capture", "evidence_chain", "review", "audit_chain"]
    },
    {
      "id": "document_register",
      "entity": "document_register",
      "blocks": ["document_engine", "version", "version_diff", "search", "file_hasher", "audit"]
    },
    {
      "id": "role_based_access_and_audit",
      "entity": "role_based_access_and_audit",
      "blocks": ["auth", "multi_tenant_rbac", "audit_fail_closed", "governance_gate"]
    }
  ],
  "source_of_record": {
    "contract": "document:62425b8c48e146f08c1ecbbaf93ba637_harbourline_contract.pdf",
    "boq": "document:9eef45a732d042dfb83157ec67068a75_harbourline_boq.xlsx",
    "clauses": ["4.2", "8.2", "8.7", "11.1", "14.3"]
  },
  "settings": {
    "required": ["PLATFORM_TOKEN"],
    "optional": ["TENANT_TOKENS", "APPROVED_PRINCIPALS", "DATABASE_URL", "BACKUP_DIR", "FASTAPI_SYNC_THREADPOOL"]
  }
}
