{
  "schema": "deploy_contract.v1",
  "product_id": "product",
  "name": "Harbourline Civil Works Contracts Administration",
  "runtime": "python",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "start": "sh scripts/entrypoint.sh",
  "port_env": "PORT",
  "health_path": "/health",
  "migrations": "on_boot: alembic upgrade head (scripts/entrypoint.sh) + app.migrations.upgrade_head",
  "persistence": {
    "root_env": "STORAGE_PATH",
    "root_default": "/app/data",
    "engine": "sqlite"
  },
  "capability_routes": [
    "POST /v1/progress_claim_management",
    "GET /v1/progress_claim_management",
    "POST /v1/delay_damages_tracking",
    "GET /v1/delay_damages_tracking",
    "POST /v1/qa_itp_records",
    "GET /v1/qa_itp_records",
    "POST /v1/document_register",
    "GET /v1/document_register",
    "POST /v1/contract_terms_governance",
    "GET /v1/contract_terms_governance",
    "POST /v1/commercial_dashboard",
    "GET /v1/commercial_dashboard"
  ],
  "support_routes": [
    "GET /",
    "GET /health",
    "GET /metrics",
    "GET /v1/capabilities",
    "GET /v1/ui",
    "GET /v1/document_register/parse",
    "POST /v1/document_register/parse",
    "POST /v1/document_register/intake",
    "GET /v1/document_register/search",
    "POST /v1/document_register/ask"
  ],
  "required_env": [
    "PLATFORM_TOKEN",
    "STORAGE_PATH"
  ],
  "optional_env": [
    "TENANT_TOKENS",
    "PLATFORM_COUNTRY",
    "PLATFORM_CURRENCY",
    "PLATFORM_TAX_RATE",
    "APPROVED_PRINCIPALS",
    "PROJECT_DOCUMENT_MANAGEMENT_SYSTEM_E_G_PROCORE_ACONEX_CREDENTIALS"
  ],
  "placeholder_connectors": {
    "document_register": "project_document_management_system_e_g_procore_aconex"
  }
}
